# Copy to .env and replace every change-me value before an Internet-facing deployment.
APP_ENV=production
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://matrix.neuromorphicinference.com
DATABASE_URL=postgresql+psycopg://matrix:change-me@postgres:5432/matrix
POSTGRES_USER=matrix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matrix
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-me-at-least-32-characters
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
INFERENCE_MODE=fake
SOVEREIGN_AVAILABLE=true
RUN_LIVE_LLM_TESTS=false
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-at-least-32-characters
LANGFUSE_SALT=change-me-at-least-32-characters
LANGFUSE_ENCRYPTION_KEY=change-me-exactly-64-hex-characters
CLICKHOUSE_PASSWORD=change-me
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=change-me-at-least-16-characters
CLOUDFLARE_TUNNEL_TOKEN=
